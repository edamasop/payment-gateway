# Port the mock gateway listens on (also accepted as the first CLI argument).
PORT=8082
# Shared HMAC-SHA256 key used to sign callbacks; must match
# PAYMENT_WEBHOOK_SECRET of payment-service.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# random | success | failed. success/failed make the mock deterministic,
# which is what scripts/smoke.sh relies on.
GATEWAY_SIMULATION=success
